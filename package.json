{
  "name": "telebox",
  "version": "1.1.0",
  "description": "TeleBox - Windows IPTV oynatici",
  "author": "TeleBox",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "hls.js": "1.5.17",
    "mpegts.js": "1.7.3"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.telebox",
    "productName": "TeleBox",
    "files": ["main.js", "preload.js", "renderer/**/*"],
    "win": { "target": "portable", "artifactName": "TeleBox-${version}-portable.exe" }
  }
}
